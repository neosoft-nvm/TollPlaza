<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the mod's plaza generator outside the game and writes a three.js preview page.
       Only UnityEngine's managed math types (Vector3, Color, Mathf) are used, so no Unity runtime is needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\PlazaGeometry.cs" Link="PlazaGeometry.cs" />
    <Reference Include="System.Drawing" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(CSII_MANAGEDPATH)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <EmbeddedResource Include="preview-template.html" LogicalName="preview-template.html" />
  </ItemGroup>

</Project>
